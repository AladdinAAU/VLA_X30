<?xml version="1.0"?>
<!--
  Wraps the upstream x30_description robot model (from the
  quadruped_ros2_control submodule) and adds a 2D lidar + RGBD camera so the
  X30 has the sensors Nav2 / SLAM Toolbox / the frontier explorer need.
  The upstream x30_description package ships no lidar or camera, only an IMU.
-->
<robot name="x30" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="GAZEBO" default="true"/>
  <xacro:arg name="CLASSIC" default="false"/>
  <xacro:include filename="$(find x30_description)/xacro/robot.xacro"/>

  <!-- ======================= Lidar (2D planar) ======================= -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <!-- Sits on the raised head of the X30 torso mesh (top surface z=0.135 at
         x=0.30..0.49; the back is lower, z=0.086). Link is 0.05 tall, so the
         scan plane at z=0.16 clears the whole body in all 360 degrees. -->
    <origin xyz="0.35 0 0.16" rpy="0 0 0"/>
    <parent link="TORSO"/>
    <child link="lidar_link"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== RGBD camera (Zed2i stand-in) ================ -->
  <link name="camera_link">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <!-- On the front face of the head (face at x=0.487, z=-0.075..0.123). The
         torso mesh is ~0.98 m long, so anything at x<0.48 is inside the body
         and renders the robot's own interior. -->
    <origin xyz="0.50 0 0.04" rpy="0 0 0"/>
    <parent link="TORSO"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== Ground-truth odometry ======================
       unitree_guide_controller has no wheel/leg odometry estimator wired
       into ros2_control, so SLAM Toolbox / Nav2 are fed ground-truth
       odom -> base TF and /odom from Gazebo directly. Good enough for a
       simulation test bed; swap for a real estimator before deploying to
       hardware.
       robot_base_frame is "base" (the URDF root), not "TORSO": TORSO
       already has a static parent (base) published by robot_state_publisher
       via the fixed floating_base joint, and TF does not allow a frame to
       have two different parents. Parenting odom at the actual root keeps
       a single, unambiguous odom -> base -> TORSO -> ... chain; TORSO
       stays reachable for nav2_params.yaml's robot_base_frame: TORSO. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

</robot>
