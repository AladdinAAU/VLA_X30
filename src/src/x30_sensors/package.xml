<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x30_sensors</name>
  <version>0.1.0</version>
  <description>Lidar + RGBD camera xacro extension for the DEEP Robotics X30, layered on top of the upstream x30_description model</description>
  <maintainer email="burgerbdd@gmail.com">burgerbdd</maintainer>
  <license>MIT</license>

  <exec_depend>x30_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
