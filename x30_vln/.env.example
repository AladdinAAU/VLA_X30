# Copy to .env (same folder) and adjust. Read by scripts/x30.ps1, scripts/x30.sh and `docker compose --env-file ../.env`.
# Paths with spaces are fine; use forward slashes for Windows paths (D:/vlm-models).

# --- ROS / DDS (all containers) ---
ROS_DOMAIN_ID=0
# File inside docker/dds/ used by every ROS 2 container: cyclonedds.xml (SPDP multicast + unicast data, default), cyclonedds-peers.xml (unicast), cyclonedds-host.xml (host network)
X30_DDS_FILE=cyclonedds.xml

# --- framework image build (match your host user on Linux: `id -u` / `id -g`; on Docker Desktop 1000 is fine) ---
HOST_UID=1000
HOST_GID=1000
X30_BUILD_JOBS=4
# Packages colcon/rosdep skip in the Humble framework container (the simulator package is Jazzy-only)
X30_SKIP_PKGS=x30_sim

# --- model servers ---
VLM_MODELS_DIR=D:/vlm-models
PERCEPTION_CACHE_DIR=D:/perception-cache
VLM_HF=Qwen/Qwen3-VL-8B-Instruct-GGUF:Q4_K_M
VLM_ALIAS=qwen3-vl
VLM_CTX=16384
VLM_PARALLEL=1
# profile two-vlm: small mapper model on port 8001 (about 5 GB VRAM incl. KV cache; downloaded on first start, not cached yet)
VLM2_HF=Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M
VLM2_ALIAS=qwen3-vl-mapper
VLM2_CTX=8192
YOLOE_WEIGHTS=yoloe-11l-seg.pt

# --- replay profile ---
# Path INSIDE the container (project root is /x30)
REPLAY_BAG=/x30/datasets/real/lab_2026-10-06
REPLAY_ARGS=--loop --clock

# --- real robot profile (ros1_bridge). Defaults point at localhost (safe); put the real addresses here before using the real profile. ---
# Rob7 reference values: master http://192.168.1.106:11311, workstation 192.168.1.131
ROS_MASTER_URI=http://127.0.0.1:11311
# Address of THIS machine on the robot network (what the ROS 1 master and the robot must connect back to)
ROS_IP=127.0.0.1
# Topic list for the bridge (file in configs/; image default is used if missing)
BRIDGE_TOPICS=/x30/configs/ros1_bridge_topics.yaml

# --- guard (scripts/x30 guard) ---
GUARD_LIMIT_GB=21
GUARD_INTERVAL_S=10
# comma-separated container names killed first when the limit is exceeded (largest first is chosen among these)
GUARD_KILL=x30-sim,x30-framework
