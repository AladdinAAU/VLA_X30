<?xml version="1.0" ?>
<!--
  lab_room: a 7 x 6 m room used to compare the simulated lidar with the recorded real bag (scripts/sim/compare_lidar_to_bag.py).
  In the bag the robot is close to the floor (floor about 0.12-0.2 m below the body frame, ceiling about 2.3 m above: it was lying down).
  The simulated robot stands (body 0.51 m above the ground), so the floor is raised VISUALLY by 0.36 m (a visual-only box: no collision, the
  lidar and cameras see it, the physics ground stays at z = 0). Spawn the robot at the room centre. Ceiling 2.33 m above the body frame (bag: 2.3-2.4 m).
-->
<sdf version="1.9" xmlns:x30="http://x30.local/sdf">
  <world name="lab_room">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.6 0.75 0.9 1</background><shadows>false</shadows><grid>false</grid></scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <x30:label>floor</x30:label>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
      </link>
    </model>
    <model name="raised_floor_visual">
      <static>true</static>
      <pose>0 0 0.18 0 0 0</pose>
      <x30:label>floor</x30:label>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>7 6 0.36</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 2.89 0 0 0</pose>
      <x30:label>ceiling</x30:label>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.2 6.2 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.2 6.2 0.1</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_n"><static>true</static><pose>0 3.05 1.45 0 0 0</pose><x30:label>wall</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>7.2 0.1 2.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.2 0.1 2.9</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -3.05 1.45 0 0 0</pose><x30:label>wall</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>7.2 0.1 2.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.2 0.1 2.9</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>3.55 0 1.45 0 0 0</pose><x30:label>wall</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>0.1 6.0 2.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.0 2.9</size></box></geometry><material><ambient>0.75 0.8 0.8 1</ambient><diffuse>0.75 0.8 0.8 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-3.55 0 1.45 0 0 0</pose><x30:label>wall</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>0.1 6.0 2.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.0 2.9</size></box></geometry><material><ambient>0.75 0.8 0.8 1</ambient><diffuse>0.75 0.8 0.8 1</diffuse></material></visual></link></model>

    <!-- furniture (visual + collision boxes), heights counted from the physics ground (z = 0); the raised floor top is at 0.36 -->
    <model name="table_1"><static>true</static><pose>1.8 1.2 0.75 0 0 0</pose><x30:label>table</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>1.4 0.7 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.4 0.7 0.8</size></box></geometry><material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material></visual></link></model>
    <model name="table_2"><static>true</static><pose>-1.8 -1.5 0.75 0 0.0 0.4</pose><x30:label>table</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>1.6 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.8 0.8</size></box></geometry><material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material></visual></link></model>
    <model name="cabinet_1"><static>true</static><pose>-3.2 1.5 1.1 0 0 0</pose><x30:label>cabinet</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>0.5 1.6 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.6 1.5</size></box></geometry><material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material></visual></link></model>
    <model name="box_1"><static>true</static><pose>2.6 -2.0 0.6 0 0 0.3</pose><x30:label>box</x30:label>
      <link name="link"><collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry><material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material></visual></link></model>
  </world>
</sdf>
