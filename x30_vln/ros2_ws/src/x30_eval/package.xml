<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x30_eval</name>
  <version>0.1.0</version>
  <description>Evaluation for the X30 VLN framework: metrics, episode runner, reports, sweeps, data export</description>
  <maintainer email="burgerbdd@gmail.com">x30</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>x30_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros_py</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
