<?xml version="1.0"?>
<package format="3">
  <name>x30_teach</name>
  <version>0.1.0</version>
  <description>Learner phase of the X30 VLN framework: understands what a person says during a guided tour (LLM) and saves named rooms and spots into the semantic map (service /teach/say).</description>
  <maintainer email="burgerbdd@gmail.com">X30 VLN</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros_py</depend>
  <depend>x30_msgs</depend>
  <depend>x30_common</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
